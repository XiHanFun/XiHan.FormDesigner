{
  "name": "@xihan-form/core",
  "type": "module",
  "version": "0.0.0",
  "description": "XiHan Form Designer core — form schema, validation, linkage rules and edit commands; pure TypeScript, no DOM.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://github.com/XiHanFun/XiHan.FormDesigner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.FormDesigner.git",
    "directory": "form/packages/core"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.FormDesigner/issues"
  },
  "keywords": [
    "form",
    "form-designer",
    "form-builder",
    "form-renderer",
    "web-components",
    "xihanfun"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@xihan-ui/core": "catalog:",
    "@xihan-ui/expression": "catalog:",
    "@xihan-ui/headless": "catalog:"
  }
}
