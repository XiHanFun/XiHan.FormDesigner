{
  "name": "@xihan-form/runtime",
  "type": "module",
  "version": "0.0.0",
  "description": "XiHan Form Designer runtime — Web Components for rendering, reading and validating forms.",
  "author": {
    "name": "XiHanFun",
    "url": "https://github.com/XiHanFun"
  },
  "license": "MIT",
  "homepage": "https://github.com/XiHanFun/XiHan.FormDesigner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiHanFun/XiHan.FormDesigner.git",
    "directory": "form/packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/XiHanFun/XiHan.FormDesigner/issues"
  },
  "keywords": [
    "form",
    "form-designer",
    "form-builder",
    "form-renderer",
    "web-components",
    "xihanfun"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./style.css": "./style.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "style.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@xihan-form/core": "workspace:^",
    "@xihan-ui/core": "catalog:",
    "@xihan-ui/designer-kit": "catalog:",
    "@xihan-ui/expression": "catalog:",
    "@xihan-ui/headless": "catalog:",
    "@xihan-ui/web-components": "catalog:"
  },
  "devDependencies": {
    "jsdom": "catalog:"
  }
}
